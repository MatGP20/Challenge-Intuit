@page "/"
@using FrontendChallenge.WeatherPage.Helpers

<PageTitle>Pronóstico</PageTitle>

<div class="row SearchBarBox">
    <div class="logoSVG col-3 d-flex">
        @* <svg version="1.0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 343.000000 139.000000" preserveAspectRatio="xMidYMid meet">  
            <g transform="translate(0.000000,139.000000) scale(0.100000,-0.100000)" fill="#ffffff" stroke="none"> 
                <path d="M1402 1308 c-7 -7 -12 -42 -12 -86 l0 -75 -69 5 c-38 3 -74 2 -80 -1 -5 -4 -11 -42 -13 -85 l-3 -79 -81 2 -81 2 4 -170 5 -171 -87 0 -87 0 3 88 c3 73 1 86 -11 83 -8 -3 -85 -5 -170 -5 l-155 -1 -3 -82 -3 -82 -77 -3 -77 -3 -3 -82 -3 -83 -89 0 -90 0 0 -91 0 -91 -71 4 -72 3 1 -82 0 -83 1630 -2 1631 -3 3 65 c6 119 19 111 -154 104 -82 -3 -161 -3 -174 0 -24 6 -24 8 -20 91 l4 85 -85 0 -84 0 3 85 3 85 -157 0 -158 0 0 -85 0 -85 -85 0 -86 0 3 255 3 254 -72 -6 -73 -6 0 87 0 86 -75 0 c-71 0 -75 1 -76 23 -1 21 -1 21 -9 -3 -5 -17 -8 -1 -8 50 0 54 2 67 8 45 7 -29 8 -29 9 -4 0 14 -5 33 -12 43 -12 16 -34 17 -297 13 -157 -2 -298 -7 -315 -11 -23 -5 -25 -4 -10 3 14 7 16 10 5 10 -9 1 -21 -4 -28 -11z m511 -5 c-68 -2 -178 -2 -245 0 -68 1 -13 3 122 3 135 0 190 -2 123 -3z" /> 
            </g> 
        </svg> *@
        <img src="/img/climate-serv-climate.gif" class="logoGif" alt="PIXEL WEATHER"/>
        @* <p class="fw-bolder text-white logoTittle">PIXEL WEATHER</p> *@
    </div>

    @if (lugarSeleccionado != null)
    {
        <div class="mb-auto text-center text-white col-5 h1">
            <strong> @lugarSeleccionado.Display </strong>
        </div>
    }
    
    <div class="position-relative col-3 ms-5">
        <input class="form-control"
               placeholder="Buscar Ciudad o Pais..."
               value="@busqueda"
               oninput="@ChangeSearch"/>

        @if (sugerencias.Any())
        {
            <ul class="list-group ListSugerencias">
                @foreach (var lugar in sugerencias)
                {
                    <li class="list-group-item list-group-item-action"
                        style="cursor: pointer"
                        @onclick="() => SeleccionarLugar(lugar)">
                        @lugar.Display
                    </li>
                }
            </ul>
        }
    </div>    
</div>

<div class="blockCurrentExtended">
    <div class="CurrentForecastBlock">
        @if (forecast != null)
        {
            <p class="px-4 h4"><strong>Tiempo actual:</strong></p>
            <div class="row justify-content-evenly">
                <div class="col-4">
                    <InlineSVG WeatherCode="@forecast.Current.Weather_Code" IsDay="@forecast.Current.Is_Day" CssClass="weatherCurrentIcon"></InlineSVG>
                    <p class="ps-3 h2 text-white text-center"><strong> @weatherCodeString </strong></p>
                </div>
                <div class="col-8 text-white ps-5 flex-column align-content-center fs-4">
                    <p class="h3">Temperatura Actual: <strong class="fw-bolder">@forecast.Current.Temperature_2m @forecast.Current_Units.Temperature_2m</strong></p>
                    <p class="h3">Temperatura Máxima: <strong class="fw-bolder">@forecast.Daily.Temperature_2m_Max.FirstOrDefault() @forecast.Current_Units.Temperature_2m</strong></p>
                    <p class="h3">Temperatura Mínima: <strong class="fw-bolder">@forecast.Daily.Temperature_2m_Min.FirstOrDefault() @forecast.Current_Units.Temperature_2m</strong></p>
                    <p class="h3">Humedad: <strong class="fw-bolder">@forecast.Current.Relative_humidity_2m %</strong></p>
                    <p class="h3">Probabilidad de Lluvia: <strong class="fw-bolder">@forecast.Current.Precipitation %</strong></p>
                </div>
            </div>
        }
    </div>
    <div class="ExtendedForecastBlock">
        <div class="px-4">
            <strong>Pronóstico extendido:</strong>
        </div>
        <div class="ExtendedForecastGrid">
            @if (forecast != null)
            {
                @for (var d = 0; d < forecast.Daily.Time.Count(); d++)
                {
                    var day = d;
                    var date = DateOnly.Parse(forecast.Daily.Time[day]);
                    <div class="dailyForecast">
                        @if (day != 0)
                        {
                            <div class="d-flex flex-row justify-content-between">
                                <p>@date.Day</p>
                                <p>@ObtenerDiaAbreviado(date)</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-row justify-content-between">
                                <p>@date.Day</p>
                                <p>Hoy</p>
                            </div>
                        }
                        <div class="text-center">
                            <InlineSVG WeatherCode="@forecast.Daily.Weather_Code[day]" IsDay=1 CssClass="weatherExtendedIcon mx-auto"></InlineSVG>
                            <p class="text-white text-center"><strong> @(WeatherCodeHelper.ObtenerDescripcion(@forecast.Daily.Weather_Code[day]))</strong></p>
                        </div>
                        <div class="d-flex flex-row justify-content-between h5">
                            <strong>@forecast.Daily.Temperature_2m_Max[day]@forecast.Current_Units.Temperature_2m</strong>
                            <strong>@forecast.Daily.Temperature_2m_Min[day]@forecast.Current_Units.Temperature_2m</strong>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="col-6 mx-auto my-4 separadorBlock"> <p> </p></div>

<div class="HistoryForecastBlock">
    <div class="text-white d-flex justify-content-between">
        <div class="mx-4 py-2 text-center align-content-center"><strong>Búsqueda histórica:</strong></div>
        <div class="d-flex">
            <div class="datesInput mx-3">
                <label for="start">Fecha Comienzo:  </label>
                <input type="date" id="start" name="historyStart" @bind=@startDayValue min="2021-03-23" max=@maxDaysPicker />
            </div>
            <div class="datesInput mx-3">
                <label for="finish">Fecha Final:</label>
                <input type="date" id="finish" @bind=@finishDayValue name="historyFinish" min="2021-03-23" max=@maxDaysPicker />
            </div>
            <button type="button" class="btn btnSearch mx-5" onclick="@SearchHistoryForecast">Buscar</button>
        </div>            
    </div>
    <div class="historyForecastGrid">
        @if (historyForecast != null)
        {
            @for (var d = 0; d < historyForecast.Daily.Time.Count(); d++)
            {
                var day = d;
                var date = DateOnly.Parse(historyForecast.Daily.Time[day]);
                <div class="historyDailyForecast text-white">
                    <div class="d-flex flex-row justify-content-between">
                        <p>@date.Day @ObtenerMesAbreviado(date.Month)</p>
                        <p>@ObtenerDiaAbreviado(date)</p>
                    </div>
                    <div class="">
                        <InlineSVG WeatherCode="@historyForecast.Daily.Weather_Code[day]" IsDay=1 CssClass="weatherExtendedIcon mx-auto"></InlineSVG>
                        <div class="d-flex flex-column">
                            <strong>Máx: @historyForecast.Daily.Temperature_2m_Max[day] @forecast.Current_Units.Temperature_2m</strong>
                            <strong>Mín: @historyForecast.Daily.Temperature_2m_Min[day] @forecast.Current_Units.Temperature_2m</strong>
                            <strong>temp. Prom: @historyForecast.Daily.Temperature_2m_mean[day] @forecast.Current_Units.Temperature_2m</strong>
                            <strong>Precip: @historyForecast.Daily.Precipitation_sum[day] mm</strong>
                        </div>                        
                    </div>
                </div>
            }
        }
    </div>
</div>

